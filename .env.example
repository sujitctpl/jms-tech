# Application Configuration
APP_NAME="Showroom Visitor Intelligence - Phase 1"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with psycopg3)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/jms_live"
# Test Database URL (fallback to SQLite in-memory or PostgreSQL)
TEST_DATABASE_URL="sqlite+pysqlite:///:memory:"

# Computer Vision & Inference Configuration
YOLO_MODEL_PATH="yolo11n.pt"
DETECTION_CONFIDENCE_THRESHOLD=0.35
PERSON_CLASS_ID=0
DEVICE="cpu"  # 'cpu', '0', 'cuda', etc.
TRACKER_TYPE="bytetrack.yaml"

# Processing Options
SAVE_DETECTION_EVENTS=false
FRAME_SKIP=0
RECONNECT_INTERVAL_SECONDS=5
MAX_RECONNECT_ATTEMPTS=5

# Logging
LOG_LEVEL="INFO"
